{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["keyshortcuts"],
  "ios": {
    "iosModuleName": "NitroKeyShortcuts"
  },
  "android": {
    "androidNamespace": ["keyshortcuts"],
    "androidCxxLibName": "NitroKeyShortcuts"
  },
  "autolinking": {
    "KeyShortcuts": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridKeyShortcuts"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridKeyShortcuts"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
